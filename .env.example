# =============================================================================
# Socius Career — Environment Variables Template
# -----------------------------------------------------------------------------
# Copy this file to `apps/web/.env.local` and fill in real values.
# In GitHub Codespaces these are injected from GitHub Secrets automatically.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values are exposed to the browser.
#
# The Firebase block can be regenerated at any time with:
#   firebase apps:sdkconfig WEB <appId> --project socius-career-web
# =============================================================================

# ---- Firebase Web SDK (client-side, safe to expose) ----
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ---- Anthropic / Claude (server-side only) ----
# The 壁打ち and the STAR extraction both run on this key.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional. Which model answers; defaults to claude-sonnet-4-6 when unset.
# EXTRACT_MODEL falls back to CHAT_MODEL when unset.
# CHAT_MODEL=claude-sonnet-4-6
# EXTRACT_MODEL=claude-sonnet-4-6

# ---- Google AI Studio / Gemini (server-side only, rollback path) ----
# No route reads this any more. lib/server/gemini.ts is kept intact so the
# 壁打ち can be switched back without a rewrite.
GEMINI_API_KEY=your-gemini-api-key
