# =============================================================================
# Socius Career — Environment Variables Template
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` (for apps/web) and fill in real values.
# In GitHub Codespaces these are injected from GitHub Secrets automatically.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values are exposed to the browser.
# =============================================================================

# ---- Supabase (client-side, safe to expose) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Supabase (server-side only, NEVER expose to the browser) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=your-project-ref

# ---- Google AI Studio / Gemini ----
GEMINI_API_KEY=your-gemini-api-key
